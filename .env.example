# ─────────────────────────────────────────────────────────────
# Aura Engine configuration
# Every integration is optional locally: missing keys switch that
# part of the product into a clearly labeled demo mode.
# ─────────────────────────────────────────────────────────────

# Public URL of the app. On Vercel this defaults to the production domain automatically.
APP_URL=http://localhost:3000

# Postgres. On Vercel the Neon integration injects both automatically.
# Locally: `docker compose up -d` then use the values below.
DATABASE_URL="postgresql://aura:aura@localhost:5432/aura"
DATABASE_URL_UNPOOLED="postgresql://aura:aura@localhost:5432/aura"

# Session signing secret (REQUIRED in production). Generate: openssl rand -base64 48
AUTH_SECRET=

# Comma-separated emails that can see /app/admin
ADMIN_EMAILS=

# Credits granted on signup
SIGNUP_CREDITS=40

# ── Claude (strategy, Brand/Story DNA, series bible, shot lists) ──
# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── Higgsfield API (character sheets, storyboard frames, video) ──
# https://console.higgsfield.ai → API keys (prepaid USD balance)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Console → Settings → webhook signing secret (starts with whsec_)
HF_WEBHOOK_SECRET=
# Optional model overrides (endpoint ids from docs.higgsfield.ai)
HF_IMAGE_MODEL=xai/grok-imagine-image-2.0
HF_VIDEO_MODEL=kling-video/v3.0/std/image-to-video

# ── Stripe (subscriptions + credit top-ups) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Media storage — needed in production because Higgsfield deletes outputs after 7 days.
#    Option A (recommended on Vercel): connect a *public* Vercel Blob store → injects
#    BLOB_READ_WRITE_TOKEN (or BLOB_STORE_ID for OIDC stores) automatically.
BLOB_READ_WRITE_TOKEN=
#    Option B: S3 / Cloudflare R2 ──
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Optional ──
# Slack / Zapier incoming webhook that receives studio + distribution leads
LEADS_WEBHOOK_URL=
# Scan rate limits
ANON_SCANS_PER_DAY=3
USER_SCANS_PER_DAY=25
# Override ffmpeg binary (defaults to ffmpeg-static, then system ffmpeg)
FFMPEG_PATH=
